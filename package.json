{
  "name": "proxy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --config prettier.config.js --write ./src/",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
		"tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vite-plugin-cross-origin-isolation": "^0.1.6"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "workspace:*",
    "dreamland": "0.0.25"
  },
  "exports": {
    "import": "./dist/main.js",
    "require": "./dist/main.cjs"
